      <file file_name="placement_flexspi_RowleyBsp.xml" />
      <file file_name="$(StudioDir)/source/thumb_crt0.s" />
    </folder>
    <folder Name="XIP">
      <file file_name="XiP/flexspi_boot.c">
        <configuration Name="Common" build_exclude_from_build="Yes" />
      </file>
      <file file_name="XiP/flexspi_boot.h" />
      <file file_name="XiP/flexspi_container_config.c" />
      <file file_name="XiP/flexspi_container_config.h" />
      <file file_name="XiP/flexspi_flash.h" />
      <file file_name="XiP/flexspi_flash_Hyperflash.c">
        <configuration Name="Common" build_exclude_from_build="Yes" />
      </file>
      <file file_name="XiP/flexspi_flash_OSPI_Adesto.c">
        <configuration Name="Common" build_exclude_from_build="Yes" />
      </file>
      <file file_name="XiP/flexspi_flash_OSPI_ISSI.c">
        <configuration Name="Common" build_exclude_from_build="Yes" />
      </file>
      <file file_name="XiP/flexspi_flash_OSPI_Macronix.c">
        <configuration Name="Common" build_exclude_from_build="Yes" />
      </file>
      <file file_name="XiP/flexspi_flash_OSPI_Micron.c" />
      <file file_name="XiP/flexspi_flash_QSPI.c" />
    </folder>
