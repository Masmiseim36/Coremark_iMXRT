      <file file_name="drivers/1180/fsl_ele_base_api.h" />
      <file file_name="drivers/fsl_flexspi.c" />
      <file file_name="drivers/fsl_flexspi.h" />
      <file file_name="drivers/fsl_iomuxc.h" />
      <file file_name="drivers/fsl_lpuart.c" />
      <file file_name="drivers/fsl_lpuart.h" />
      <file file_name="drivers/fsl_pdm.c" />
      <file file_name="drivers/fsl_pdm.h" />
      <file file_name="drivers/1180/fsl_pmu.c" />
      <file file_name="drivers/1180/fsl_pmu.h" />
      <file file_name="drivers/fsl_rgpio.c" />
      <file file_name="drivers/fsl_rgpio.h" />
      <file file_name="drivers/fsl_s3mu.c" />
      <file file_name="drivers/fsl_s3mu.h" />
    </folder>
    <folder Name="src">
      <file file_name="boards/1180/board.c" />
      <file file_name="boards/1180/board.h" />
      <file file_name="boards/1180/clock_config.c" />
      <file file_name="boards/1180/clock_config.h" />
      <file file_name="boards/1180/config.h" />
      <file file_name="boards/1180/pin_mux.c" />
      <file file_name="boards/1180/pin_mux.h" />
    </folder>
    <folder Name="System Files">
      <configuration
        Name="Common"
        default_code_section=".init"
        default_const_section=".init_rodata"
        default_data_section=".data"
        default_zeroed_section=".bss"
        link_time_optimization="No" />
      <file file_name="$(DeviceStartFile)" />
      <file file_name="$(DeviceSystemFile)" />
