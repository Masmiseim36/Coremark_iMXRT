<!DOCTYPE CrossStudio_Project_File>
<solution Name="Coremark iMXRT - original" target="8" version="2">
  <configuration
    Name="Common"
    Platform="ARM"
    arm_instruction_set="Thumb"
    arm_library_instruction_set="Thumb"
    arm_target_interface_type="SWD"
    build_intermediate_directory="out/$(ProjectName) $(Configuration)"
    build_output_directory="bin/$(ProjectName) $(Configuration)"
    c_preprocessor_definitions="__THUMB;VECTORS_IN_RAM=1;STARTUP_FROM_RESET=1;PRINTF_FLOAT_ENABLE=1;INITIALIZE_TCM_SECTIONS=1;SERIAL_PORT_TYPE_UART=1"
    default_code_section=".fast"
    default_const_section=".rodata_tcm"
    default_data_section=".data_tcm"
    default_zeroed_section=".bss_tcm"
    gcc_c_language_standard="c11"
    gcc_cplusplus_language_standard="c++17"
    gcc_debugging_level="Level 3"
    gcc_dwarf_version="dwarf-3"
    gcc_omit_frame_pointer="Yes"
    hidden="Yes"
    linker_output_format="bin" />
  <configuration
    Name="Debug"
    c_preprocessor_definitions="DEBUG"
    gcc_optimization_level="Level 0" />
  <configuration
    Name="Release"
    c_preprocessor_definitions="NDEBUG"
    gcc_optimization_level="Level 3"
    link_time_optimization="No" />
  <project Name="FRDM 1186 CM33">
    <configuration
      CMSIS_CORE="Yes"
      Name="Common"
      Placement="FlexSPI2 (QuadSPI, No DCD)"
      Target="MIMXRT1186XVJ8C_M33"
      arm_architecture="v8M_Mainline"
      arm_core_type="Cortex-M33"
      arm_fp_abi="Hard"
      arm_fpu_type="FPv5-SP-D16"
      arm_linker_additional_output_file_gap_fill="0xFF"
      arm_linker_script_generator_default_fill_pattern="0xFF"
      arm_linker_stack_size="10240"
      arm_target_device_name="MIMXRT1186xxx8_M33"
      arm_target_loader_applicable_loaders="Flash"
      arm_target_loader_default_loader="Flash"
      arm_v8M_has_cmse="Yes"
      arm_v8M_has_dsp="Yes"
      c_preprocessor_definitions="XIP_BOOT_FLEXSPI2=1"
      c_system_include_directories="$(StudioDir)/include;$(PackagesDir)/include;$(TargetsDir)/iMXRT;$(TargetsDir)/iMXRT/devices/$(DeviceFamily)"
      c_user_include_directories="./drivers/1180;./drivers/1180/cm33;./drivers;./boards/1180"
      debug_dependent_projects="FRDM 1186 CM7"
      debug_register_definition_file="$(TargetsDir)/iMXRT/XML/MIMXRT118x_cm33_Registers.xml"
      debug_startup_completion_point="main"
      linker_memory_map_file="$(TargetsDir)/iMXRT/MIMXRT1186_cm33_MemoryMap.xml"
      linker_memory_map_macros="OCRAMSTART=0x20490000;FlexSPI2SIZE=0x00010000;FlexSPI2SIZE_NS=0x00010000"
      linker_section_placement_file="$(TargetsDir)/iMXRT/flexspi_placement.xml"
      linker_section_placement_macros="FLASH_NAME=FlexSPI2"
      macros="HYPER=MIMXRT118x_FlexSPI_NOR_API;QSPI=MIMXRT118x_FlexSPI_NOR_API_M33"
      project_dependencies="FRDM 1186 CM7"
      project_directory=""
      project_type="Executable"
      property_groups_file_path="$(TargetsDir)/iMXRT/propertyGroups.xml"
      target_connect_script="Connect()"
      target_get_partname_script="GetPartName()"
      target_match_partname_script="MatchPartName(&quot;$(Target)&quot;)"
      target_reset_script="Reset()"
      target_script_file="$(TargetsDir)/iMXRT/iMXRT_Target.js"
      target_trace_initialize_script="EnableTrace(&quot;$(TraceInterfaceType)&quot;)" />
    <configuration
      Name="Flash"
      arm_target_flash_loader_file_path="$(TargetsDir)/iMXRT/Loader/$(QSPI)_Loader.elf"
      arm_target_loader_can_lock_all="No"
      arm_target_loader_can_lock_range="No"
      arm_target_loader_can_unlock_all="No"
      arm_target_loader_can_unlock_range="No"
      arm_target_loader_parameter="24000000" />
    <folder Name="coremark">
      <file file_name="core_list_join.c" />
      <file file_name="core_main.c" />
      <file file_name="core_matrix.c" />
      <file file_name="core_portme.cpp" />
      <file file_name="core_portme.h" />
      <file file_name="core_state.c" />
      <file file_name="core_util.c" />
      <file file_name="coremark.h" />
    </folder>
    <folder Name="drivers">
      <file file_name="drivers/1180/cm33/fsl_cache.c" />
      <file file_name="drivers/1180/cm33/fsl_cache.h" />
      <file file_name="drivers/1180/fsl_clock.c" />
      <file file_name="drivers/1180/fsl_clock.h" />
      <file file_name="drivers/fsl_common.c" />
      <file file_name="drivers/fsl_common.h" />
      <file file_name="drivers/fsl_common_arm.c" />
      <file file_name="drivers/fsl_common_arm.h" />
